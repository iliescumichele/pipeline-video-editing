{
  "type": "object",
  "properties": {
    "notes": {
      "type": "string",
      "maxLength": 1200
    },
    "angle": {
      "type": "string",
      "maxLength": 300
    },
    "status_of_info": {
      "type": "string",
      "enum": [
        "confirmed",
        "mixed",
        "rumor"
      ]
    },
    "titles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 90
      }
    },
    "thumbnails": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 40
          },
          "image": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "text",
          "image"
        ],
        "additionalProperties": false
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 9,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 60
          },
          "voice": {
            "type": "string"
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "maxLength": 120
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "trailer",
                    "image",
                    "photo",
                    "card",
                    "gameplay",
                    "lucio",
                    "leak"
                  ]
                },
                "show": {
                  "type": "string",
                  "maxLength": 300
                },
                "source": {
                  "type": "string",
                  "maxLength": 400
                },
                "card_text": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "at",
                "kind",
                "show",
                "source",
                "card_text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "voice",
          "beats"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 400
          },
          "source": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "claim",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "youtube": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "tags": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "required": [
        "description",
        "tags"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "notes",
    "angle",
    "status_of_info",
    "titles",
    "thumbnails",
    "chapters",
    "facts",
    "youtube"
  ],
  "additionalProperties": false
}
