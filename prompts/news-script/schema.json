{
  "type": "object",
  "properties": {
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "angle": {
      "type": "string",
      "maxLength": 300
    },
    "hook": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^\\S+(\\s+\\S+){1,7}$"
    },
    "script": {
      "type": "string",
      "minLength": 300,
      "maxLength": 1100
    },
    "on_screen": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 300
          },
          "source": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "claim",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "status_of_info": {
      "type": "string",
      "enum": [
        "confirmed",
        "mixed",
        "rumor"
      ]
    },
    "youtube": {
      "$ref": "#/$defs/platform"
    },
    "instagram": {
      "$ref": "#/$defs/platform"
    },
    "tiktok": {
      "$ref": "#/$defs/platform"
    }
  },
  "required": [
    "notes",
    "angle",
    "hook",
    "script",
    "on_screen",
    "facts",
    "status_of_info",
    "youtube",
    "instagram",
    "tiktok"
  ],
  "additionalProperties": false,
  "$defs": {
    "platform": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "hashtags": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "pattern": "^#[A-Za-z0-9_]+$"
          }
        }
      },
      "required": [
        "title",
        "description",
        "hashtags"
      ],
      "additionalProperties": false
    }
  }
}
